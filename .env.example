# Copy to .env (gitignored) for local dev. In production, set these as Railway service variables.
# Never put a real key in this file: it is committed.
ANTHROPIC_API_KEY=

# Pinned model for the app. Default is provisional (Sonnet 5.5), to be finalized from eval numbers.
MODEL_ID=claude-sonnet-5-5
MODEL_EFFORT=medium

# Shared access code for every route except /healthz (at least 12 characters). Required.
APP_ACCESS_CODE=

# Where SQLite (audit log, corrections, usage ledger, cache) lives: ./data locally, /data on Railway.
DATA_DIR=data

# Daily caps (UTC day); both fail closed. Concurrency and per-IP limits.
DAILY_CALL_CAP=200
DAILY_SPEND_CAP_USD=5.00
MAX_CONCURRENT_CLAIMS=3
RATE_LIMIT_CLAIMS_PER_MIN=6
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REQUESTS_PER_MIN=120
# 0 locally; 1 on Railway (one edge proxy appends the real client IP to X-Forwarded-For).
TRUST_PROXY_HOPS=0
CLAIM_DEADLINE_S=60

# Body-shop labor rate, USD/hour. Source: 2026 "Who Pays for What?" survey, median non-DRP
# body labor rate. Varies a lot by state. Regional tiers are assumptions with no source.
LABOR_RATE_USD_PER_HOUR=68
